# Copy to .env for local development. Never commit the real .env — it's gitignored.
# In Vercel, set these as Project → Settings → Environment Variables instead, split
# across Development / Preview / Production so sandbox and live credentials never mix.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare R2 (platform storage node) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_CREDENTIALS_SECRET=

# --- Cashfree ---
# Sandbox keys for local/dev; production keys ONLY in the Vercel Production environment.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2026-01-01
NEXT_PUBLIC_CASHFREE_MODE=sandbox

# --- Dev-only tooling (leave false/unset outside local development) ---
NEXT_PUBLIC_ENABLE_DEV_PRO_SIMULATION=false

# --- Cron ---
# Any long random string. Vercel Cron sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
